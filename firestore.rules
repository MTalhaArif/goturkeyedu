rules_version = '2';

// NOT auto-deployed by Vercel. Deploy with `firebase deploy --only firestore:rules`
// (firebase.json points here) — review against what's live in the Firebase Console
// (project goturkey-74ff4) first.
//
// Account creation/disable for agencies & sub-agencies goes through the
// Firebase Admin SDK (Next.js Route Handlers under src/app/api/**), which
// bypasses these rules entirely — the `create`/status-field restrictions below
// exist to stop the same actions being done directly from the browser.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && myProfile().role == 'super_admin';
    }

    // Disabling an account (via /api/*/status) can't invalidate an ID token that was
    // already issued, so tenant data access also checks the stored status. get() of
    // the same doc is cached within one rule evaluation, so this adds no extra reads
    // beyond the first myProfile() lookup.
    function isActiveTenant() {
      return isSignedIn() && myProfile().status != 'disabled';
    }

    // ── Portal accounts (students, super_admin, agency, sub_agency) ─────────
    match /users/{uid} {
      // The parent-agency check reads resource.data directly (not a get() of the same
      // doc) so that list queries like getSubAgenciesByParent() can be proven safe —
      // Firestore rejects a whole query whose rule it can't evaluate from the query.
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        isSuperAdmin() ||
        (resource.data.parentAgencyId == request.auth.uid && isActiveTenant())
      );
      // Students self-register client-side (src/app/register/page.js: Auth signup
      // immediately followed by writing their own profile doc) - only 'student'
      // role docs with no hierarchy fields may be self-created this way. Agency/
      // sub_agency/super_admin accounts are still created only via the Admin-SDK
      // routes, which bypass these rules entirely.
      allow create: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.role == 'student' &&
        !('parentAgencyId' in request.resource.data);
      allow delete: if false;
      // Own profile may be edited for non-sensitive fields; role/status/hierarchy
      // fields are locked to server-side (Admin SDK) writes only.
      allow update: if isSignedIn() && request.auth.uid == uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'parentAgencyId']);
    }

    // ── Student CRM records managed by an Agency/Sub-Agency ─────────────────
    match /students/{studentId} {
      allow read: if isSuperAdmin() || (
        isActiveTenant() &&
        (resource.data.agencyId == request.auth.uid || resource.data.ownerId == request.auth.uid)
      );

      allow create: if isActiveTenant() &&
        request.resource.data.ownerId == request.auth.uid &&
        (
          (myProfile().role == 'agency' && request.resource.data.agencyId == request.auth.uid) ||
          (myProfile().role == 'sub_agency' && request.resource.data.agencyId == myProfile().parentAgencyId)
        );

      allow update, delete: if isSuperAdmin() || (isActiveTenant() && resource.data.ownerId == request.auth.uid);
    }

    // ── Public marketing-site collections ────────────────────────────────────
    match /universities/{id} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /scholarships/{id} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /contacts/{id} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    // Student dashboard applications, auto-ID (many per self-registered student —
    // one per university/program applied to), ownership via the studentUid field.
    //
    // Stage workflows (see STATE_STEPS / FOUNDATION_STEPS in StudentDashboard.js):
    //   State:      documents_pending → payment_pending → payment_submitted → payment_verified* → offer_made* → accepted
    //   Foundation: documents_pending → under_review → offer_made* → accepted
    //   (* = Super Admin only)
    //
    // Students may only make the forward moves the dashboard itself makes, and may
    // only touch `stage` and `paymentScreenshot` — `offer`, `adminNotes`, `studentUid`
    // and the university fields are fixed at creation / admin-owned.
    function studentStartStage(stage) {
      return stage in ['documents_pending', 'payment_pending', 'under_review'];
    }

    function studentStageMoveAllowed(from, to) {
      return from == to ||
        (from == 'documents_pending' && to in ['payment_pending', 'under_review']) ||
        (from == 'payment_pending' && to == 'payment_submitted') ||
        (from == 'offer_made' && to == 'accepted');
    }

    match /applications/{appId} {
      allow read: if isSignedIn() && (resource.data.studentUid == request.auth.uid || isSuperAdmin());

      allow create: if isSuperAdmin() || (
        isSignedIn() &&
        request.resource.data.studentUid == request.auth.uid &&
        studentStartStage(request.resource.data.stage) &&
        request.resource.data.get('offer', null) == null &&
        request.resource.data.get('paymentScreenshot', null) == null &&
        request.resource.data.get('adminNotes', '') == ''
      );

      allow update: if isSuperAdmin() || (
        isSignedIn() &&
        resource.data.studentUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['stage', 'paymentScreenshot', 'updatedAt']) &&
        studentStageMoveAllowed(resource.data.stage, request.resource.data.stage) &&
        // Payment proof can only be (re)uploaded while payment is still the student's step.
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentScreenshot']) ||
          resource.data.stage in ['payment_pending', 'payment_submitted'])
      );

      allow delete: if false;
    }

    match /documents/{id} {
      allow read, write: if isSuperAdmin();
    }

    match /notifications/{id} {
      allow read, write: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
