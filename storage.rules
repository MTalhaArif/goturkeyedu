rules_version = '2';

// NOT auto-deployed by Vercel. Deploy with `firebase deploy --only storage`
// (firebase.json points here) for project goturkey-74ff4. The first deploy of a rule
// that calls firestore.get() asks to grant Storage permission to read Firestore —
// accept it, or the super-admin check below always evaluates to false.
//
// Covers student dashboard document uploads (passport, transcripts, other, payment
// screenshot) written by src/lib/storage.js to applications/{uid}/{fileName}. Documents
// are shared across all of a student's applications; payment screenshots stay unique
// per application via the `kind` embedded in the filename rather than a path segment.

service firebase.storage {
  match /b/{bucket}/o {

    function isSuperAdmin() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    match /applications/{uid}/{fileName} {
      // Passports, transcripts and payment proofs: only the owning student and Super
      // Admin may read or list them through the SDK. Download URLs issued by
      // getDownloadURL() carry their own token and keep working regardless of this rule,
      // which is what the admin review screen and its ZIP download already use — so
      // closing SDK reads does not break them, it just stops anonymous listing/downloads
      // of other students' files.
      allow read: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
      allow write: if request.auth != null && request.auth.uid == uid &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('application/pdf|image/jpeg|image/png');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
